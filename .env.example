# ==============================================================================
# LOOPWEAR (CLOSET CIRCLE) ENVIRONMENT CONFIGURATION
# ZERO-BUDGET MANDATE: All variables below have safe zero-budget defaults.
# No accounts or credit cards required to run locally.
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=LoopWear
CLIENT_URL=http://localhost:5173

# Database (MongoDB Community local container or Atlas free tier M0)
MONGO_URI=mongodb://127.0.0.1:27017/loopwear

# Queue Engine: 'memory' (0 dependencies, works on sleeping instances) or 'bullmq' (local redis)
QUEUE_TYPE=memory
REDIS_URL=redis://127.0.0.1:6379

# Security Secrets (Must change before production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_32_characters_minimum!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_32_characters_minimum!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# External Cron Trigger Secret (Free GitHub Actions cron or external scheduler)
CRON_SECRET=dev_cron_secret_key_change_in_production

# Captcha Adapter: 'bypass' (dev/testing) | 'turnstile' (Cloudflare free tier) | 'hcaptcha'
DEV_BYPASS_CAPTCHA=true
CAPTCHA_DRIVER=bypass
CAPTCHA_SECRET_KEY=

# Mail Adapter: 'console' (local terminal log for OTP) | 'smtp' (free SMTP or Brevo/SendGrid free tier)
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LoopWear <noreply@loopwear.in>

# SMS Adapter: 'console' (console stub only; NO paid SMS gateway per LoopWear rules)
SMS_DRIVER=console

# Media Storage: 'local' (disk uploads in dev) | 'freemedia' (Cloudinary free tier)
STORAGE_DRIVER=local

# Payment Gateway: 'mock' (works with zero account) | 'razorpay_test' (test mode only)
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Push Notifications: 'inapp' (internal in-app notifications store) | 'fcm' (FCM free tier)
PUSH_DRIVER=inapp
FCM_SERVER_KEY=
