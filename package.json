{
  "name": "loopwear-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LoopWear (Closet Circle) - Peer-to-peer clothing rental platform",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "start": "npm run start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:test": "npm run test --prefix backend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "test": "npm run backend:test"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
