{
  "name": "relooka",
  "version": "1.0.0",
  "private": true,
  "description": "Relooka - Peer-to-peer clothing rental platform",
  "scripts": {
    "dev": "concurrently -n \"backend,flutter-web\" -c \"blue,green\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "dev:all": "concurrently -n \"agent,backend,flutter-web\" -c \"magenta,blue,green\" \"npm run agent:dev\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "agent:dev": "python -m uvicorn app.main:app --app-dir \"D:/Agents\" --host 0.0.0.0 --port 8000 --reload",
    "start": "npm run start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:test": "npm run test --prefix backend",
    "frontend:dev": "\"D:\\flutter\\bin\\flutter.bat\" run -d web-server --web-port 5173 --web-hostname 0.0.0.0",
    "frontend:build": "\"D:\\flutter\\bin\\flutter.bat\" build web --release --no-web-resources-cdn --pwa-strategy=none",
    "flutter:dev": "\"D:\\flutter\\bin\\flutter.bat\" run -d web-server --web-port 5173 --web-hostname 0.0.0.0",
    "flutter:build": "\"D:\\flutter\\bin\\flutter.bat\" build web --release --no-web-resources-cdn --pwa-strategy=none",
    "frontend:react:dev": "npm run dev --prefix frontend",
    "frontend:react:build": "npm run build --prefix frontend",
    "test": "npm run backend:test"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
