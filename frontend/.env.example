# LoopWear (Closet Circle) Frontend Environment Configuration
# ZERO-BUDGET RULE: Works locally and hosted with zero paid keys.

# Backend API Base URL (defaults to /api/v1 via Vite proxy in dev, set to full host URL in production)
VITE_API_URL=/api/v1

# Captcha Dev Bypass (Set to 'true' to allow 1-click captcha completion in local development)
VITE_DEV_BYPASS_CAPTCHA=true

# Cloudflare Turnstile / hCaptcha Free-Tier Public Site Key (Permanent free tier, optional in dev)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Razorpay Test Mode Key (Optional: when omitted, frontend automatically routes through built-in zero-key MockGateway)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_free_key
